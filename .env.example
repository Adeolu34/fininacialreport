# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/financial_reports

# Redis
REDIS_URL=redis://redis:6379/0

# Portal 1 credentials
PORTAL_1_URL=https://portal1.example.com
PORTAL_1_USER=portal1_username
PORTAL_1_PASS=portal1_password

# Portal 2 credentials
PORTAL_2_URL=https://portal2.example.com
PORTAL_2_USER=portal2_username
PORTAL_2_PASS=portal2_password

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Report recipients (comma-separated)
REPORT_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Directories
DOWNLOADS_DIR=/app/downloads
REPORTS_OUTPUT_DIR=/app/reports
SCREENSHOTS_DIR=/app/screenshots

# Logging
LOG_LEVEL=INFO

# Scheduler
REPORT_SCHEDULE_HOUR=8
REPORT_SCHEDULE_MINUTE=0
